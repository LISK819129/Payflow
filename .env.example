# Copy to .env.local (or run `pnpm env:init`, which generates the secrets).
# Never commit .env.local.

APP_URL=http://localhost:3000

# Local dev uses `pnpm db:start` (embedded PostgreSQL on port 54329).
DATABASE_URL=postgres://payflow:payflow-local-dev@127.0.0.1:54329/payflow
TEST_DATABASE_URL=postgres://payflow:payflow-local-dev@127.0.0.1:54329/payflow_test

# 32+ random characters. `pnpm env:init` fills this in.
SESSION_SECRET=

# Seeded owner account for the PixelForge workspace (`pnpm db:seed`).
SEED_OWNER_EMAIL=owner@pixelforge.test
SEED_OWNER_PASSWORD=

# --- PayPal (Sandbox only) ---------------------------------------------------
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Returned when the webhook is registered (pnpm paypal:webhook:register)
PAYPAL_WEBHOOK_ID=
# Accept unsigned-by-real-webhook events from PayPal's webhook simulator.
# They are stored with SIMULATED provenance. Keep false outside development.
PAYPAL_ALLOW_SIMULATOR_EVENTS=false

# --- AI ------------------------------------------------------------------------
# openai (default) or anthropic. Only the selected provider's key is needed.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Hard lifetime budget for real model calls, USD. Calls that could exceed it are refused.
AI_BUDGET_USD=5
# Optional overrides; defaults (gpt-5.4-mini / gpt-5.4-nano) are set in src/server/ai
AI_MODEL_COMPILE=
AI_MODEL_FAST=
# Max output tokens per compile call (reasoning + answer); worst-case cost scales with it.
AI_MAX_OUTPUT_TOKENS=16000
